<div>
    <div>
        <h2>Login</h2>

        <form>
            <div>
                <label for="email-login">Email:</label>
                <input type="text" class="form-input" id="email-login" />
            </div>
            <div>
                <label for="password-login">Password:</label>
                <input type="password" class="form-input" id="password-login" />
            </div>
            <div>
                <button type="submit" id="login">Login Here</button>
            </div>
        </form>
    </div>
    <div>
        <h2>Signup</h2>
        <form>
            <div>
                <label for="name-signup">Name:</label>
                <input type="text" class="form-input" id="name-signup" />
            </div>
            <div>
                <label for="email-signup">Email:</label>
                <input type="text" class="form-input" id="email-signup" />
            </div>
            <div>
                <label for="password-signup">Password:</label>
                <input type="password" class="form-input" id="password-signup" />
            </div>
            <div>
                <button type="submit" id="signup">Sign Up Here</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/login.js"></script>